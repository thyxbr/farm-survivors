; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ecos de Valdoria"
config/description="Protótipo de RPG de ação em 3ª pessoa."
config/version="0.109.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Balance="*res://scripts/autoload/balance.gd"
ItemDB="*res://scripts/autoload/item_db.gd"
Game="*res://scripts/autoload/game.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Music="*res://scripts/autoload/music.gd"
Network="*res://scripts/autoload/network.gd"
Econ="*res://scripts/autoload/econ.gd"
Auth="*res://scripts/autoload/auth.gd"
Hub="*res://scripts/autoload/hub.gd"
Updater="*res://scripts/autoload/updater.gd"
Toon="*res://scripts/autoload/toon.gd"
Weather="*res://scripts/autoload/weather.gd"
Loading="*res://scripts/autoload/loading.gd"
Party="*res://scripts/autoload/party.gd"
Social="*res://scripts/autoload/social.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemies"
3d_physics/layer_4="npc"
3d_physics/layer_5="pickups"

[physics]

common/physics_interpolation=true

[rendering]

anti_aliasing/quality/msaa_3d=2

[shader_globals]

weather_wet={
"type": "float",
"value": 0.0
}
weather_snow={
"type": "float",
"value": 0.0
}
weather_rain={
"type": "float",
"value": 0.0
}
weather_wind={
"type": "float",
"value": 0.0
}
weather_phase={
"type": "float",
"value": 0.0
}
weather_wind_dir={
"type": "vec2",
"value": Vector2(1, 0)
}
season_autumn={
"type": "float",
"value": 0.0
}
